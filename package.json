{
  "name": "vir-signals",
  "displayName": "VIR Signals",
  "description": "%vir.ext.description%",
  "publisher": "XKDMW404",
  "version": "0.1.0",
  "icon": "icon.png",
  "license": "MIT",
  "author": "XKDMW404",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/ui/extension.js",
  "l10n": "./l10n",
  "categories": [
    "Other"
  ],
  "keywords": [
    "voice pack",
    "sound effects",
    "audio cues",
    "alert sounds",
    "accessibility"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/VIR-signals/vir-signals"
  },
  "scripts": {
    "vscode:uninstall": "node ./out/uninstall-hook.js",
    "compile": "tsc -p tsconfig.json",
    "test": "node test/run-tests.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.7.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "vir.openPacksFolder",
        "title": "%vir.cmd.openPacksFolder.title%"
      },
      {
        "command": "vir.rescan",
        "title": "%vir.cmd.rescan.title%"
      },
      {
        "command": "vir.selectPack",
        "title": "%vir.cmd.selectPack.title%"
      },
      {
        "command": "vir.apply",
        "title": "%vir.cmd.apply.title%"
      },
      {
        "command": "vir.restoreSounds",
        "title": "%vir.cmd.restoreSounds.title%"
      },
      {
        "command": "vir.openSignalSettings",
        "title": "%vir.cmd.openSignalSettings.title%"
      },
      {
        "command": "vir.enableAllSignals",
        "title": "%vir.cmd.enableAllSignals.title%"
      },
      {
        "command": "vir.restoreToggles",
        "title": "%vir.cmd.restoreToggles.title%"
      },
      {
        "command": "vir.status",
        "title": "%vir.cmd.status.title%"
      },
      {
        "command": "vir.deleteBackup",
        "title": "%vir.cmd.deleteBackup.title%"
      },
      {
        "command": "vir.identify",
        "title": "%vir.cmd.identify.title%"
      },
      {
        "command": "vir.toggleSwitch",
        "title": "%vir.cmd.toggleSwitch.title%"
      }
    ],
    "configuration": {
      "title": "%vir.config.title%",
      "properties": {
        "vir.editorInstallPath": {
          "type": "string",
          "default": "",
          "description": "%vir.editorInstallPath.description%"
        },
        "vir.packRegistryRepo": {
          "type": "string",
          "default": "VIR-signals/VIR-registry",
          "description": "%vir.packRegistryRepo.description%"
        },
        "vir.packMirrorTemplate": {
          "type": "string",
          "default": "",
          "description": "%vir.packMirrorTemplate.description%"
        }
      }
    }
  }
}
